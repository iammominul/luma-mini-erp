{
  "permissions": {
    "allow": [
      "Bash(node .claude/hooks/style-check.mjs:*)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm test:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/style-check.mjs",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
