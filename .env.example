# Interim Billing - environment
# Copy to .env.local for local work; set the same keys in the Vercel project.

# Neon Postgres pooled connection string (Neon dashboard > Connection string).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Random string Better Auth signs sessions with. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it signs everyone out, which is the fastest way to lock the app.
# SESSION_SECRET is still read if AUTH_SECRET is not set, so a deployment that
# predates named users keeps working without an edit.
AUTH_SECRET="change-me-before-you-deploy"

# Where the app is served. Left unset, the origin is read off the request,
# which is what a preview deployment needs. Set it to pin production.
# AUTH_URL="https://billing.example.com"

# There is no APP_PASSWORD any more. Accounts are named, and the first Owner is
# created from the server with:
#   node scripts/create-user.mjs --email you@example.com --name "Your Name" \
#     --role owner --password "at least twelve characters"
# After that an Owner adds people on the Users screen. Sign-up is closed.

# Letterhead for statements and bills. Nothing about the company is hard-coded
# in the source, so this app can serve any dyeing trader. The logo is the same
# idea in file form: replace assets/letterhead-logo.svg, or point PDF_LOGO_PATH
# at another file. With no logo file the letterhead sets COMPANY_NAME as text.
COMPANY_NAME="LUMA TEXTILE"
COMPANY_ADDRESS="H12, Road NS-01, Block K, Eastern Housing, Pallabi, Dhaka-1216, Bangladesh"
COMPANY_PHONE="+880 1778-661144, +880 1711-659155"
COMPANY_EMAIL="info@lumatextile.com"
COMPANY_WEB="www.lumatextile.com"

# Neon project control. Production only, and only for the deploy: scripts/
# migrate.mjs uses these to take a backup/<timestamp> branch before it applies
# the schema, and to prune all but the newest five. Without the key a release
# still ships, loudly, with no restore point behind it.
#
# NEON_PROJECT_ID is required whenever the key is org-scoped, which is what the
# Neon console issues by default. Without it migrate.mjs asks the API which
# projects the key can see, and an org-scoped key refuses to answer.
# Neon Console > Settings > General for the id, Account settings > API keys for
# the key.
# NEON_PROJECT_ID="dawn-example-12345678"
# NEON_API_KEY="napi_..."

# Local only, and never set on a deployment. scripts/pull-prod.mjs reads the
# production connection string from .env.production.local; set this to point one
# run somewhere else instead.
# PROD_DATABASE_URL="postgresql://..."
