# Interim Billing - environment
# Copy to .env.local for local work; set the same keys in the Vercel project.

# Neon Postgres pooled connection string (Neon dashboard > Connection string).
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# The single shared password that opens the app. Use at least 12 characters.
APP_PASSWORD="change-me-before-you-deploy"

# Random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"

# Letterhead for statements and bills. Nothing about the company is hard-coded
# in the source, so this app can serve any dyeing trader.
COMPANY_NAME="LUMA TEXTILE"
COMPANY_ADDRESS="House 00, Road 00, Dhaka, Bangladesh"
COMPANY_PHONE="+880 0000 000000"
COMPANY_EMAIL="accounts@example.com"
