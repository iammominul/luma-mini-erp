{
  "name": "luma-mini-erp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Interim billing, receipts, and statements for a knit dyeing trader. Runs until the full ERP takes over.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 5174",
    "build": "next build",
